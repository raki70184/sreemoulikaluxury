CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_BASE_FOLDER=websites/sm-luxe-salon

# Analytics — public-by-design (ship to client). Set in Netlify env vars too.
# Leave blank to disable.
VITE_GA4_ID=G-XXXXXXXXXX
VITE_CF_BEACON_TOKEN=your_cloudflare_web_analytics_token

# Google rating auto-fetch (server-side, build-time ONLY — never VITE_-prefixed,
# so the key is never shipped to the browser). Set GOOGLE_PLACES_API_KEY in
# Netlify to auto-refresh the rating + review count on every deploy via
# scripts/fetch-google-rating.mjs. Without it, the committed fallback in
# src/data/googleRating.generated.ts is used. GOOGLE_PLACE_ID is optional.
GOOGLE_PLACES_API_KEY=your_places_api_key
GOOGLE_PLACE_ID=ChIJu3tkyN-byzsRDq93zKzDG2M
