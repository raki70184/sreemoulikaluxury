// Security gate for the salon site. Same shape as the ones in
// OneKlick-ChatPortal and oneklick-website, deliberately — one file to read
// across the fleet.
//
// The bar is zero unexplained production advisories. Exceptions are named here
// with a reason and an exit condition rather than living in someone's head — a
// gate that is red every morning is a gate that gets ignored, which is how a
// real finding gets missed.
//
// An empty allowlist is the goal state. Every entry below is a debt with a name
// on it.
//
// Run locally with:  npx audit-ci@^7 --config ./audit-ci.jsonc
{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",

  // Moderate and up. This tree is 13 runtime dependencies — there is no noise
  // here for a real finding to hide in, so there is no reason to set the bar
  // at `high`.
  "moderate": true,

  // Production dependencies only. A dev-only advisory never reaches a visitor.
  "skip-dev": true,

  // ── Accepted risks ────────────────────────────────────────────────
  "allowlist": [
    // Three react-router advisories, all moderate, all with the SAME exit:
    //
    //   GHSA-wrjc-x8rr-h8h6  open redirect via backslash in <Link>/useNavigate
    //                        (CVE-2025-68470 bypass) — fixed in 7.18.0
    //   GHSA-337j-9hxr-rhxg  arbitrary constructor injection via
    //                        deserializeErrors() in SSR hydration — fixed in
    //                        7.18.0
    //   GHSA-jjmj-jmhj-qwj2  open redirect leading to XSS — affected
    //                        react-router-dom 6.30.2-6.30.4 with
    //                        first_patched_version **null**
    //
    // ⚠️ There is NO v6 release that fixes any of them. The v6 line has no
    // patch path here; react-router 7.18.0+ is the only fix. That makes the v7
    // migration a scheduled project, and this allowlist a holding position
    // rather than a resolution.
    //
    // NOT REACHABLE HERE, audited 2026-08-07:
    //
    // Both open-redirect advisories need an attacker-controlled value to reach
    // the PATH of a <Link to> or navigate(). This site has NO route parameters
    // at all (App.tsx declares six literal routes: / /about /services /contact
    // /gallery /cafe) and does not call useParams, useSearchParams,
    // location.search or URLSearchParams anywhere. Every navigate() target is
    // either a string literal or comes from a hardcoded array in the same file
    // — leftLinks/rightLinks in AppBarComponent.tsx, the services list in
    // ServicesSection.tsx. Nothing routes off user input.
    //
    // The SSR advisory is unreachable structurally: src/index.tsx uses
    // createRoot().render(), NOT hydrateRoot — a deliberate choice documented
    // in that file (Puppeteer prerenders at a fixed 1280px viewport, so
    // hydrating would mismatch responsive hooks and throw React #418). There is
    // no data router, no StaticRouterProvider, no server entry. deserializeErrors
    // is on a path this app does not have.
    //
    // EXIT: remove all three when the react-router 7 migration lands.
    "GHSA-wrjc-x8rr-h8h6",
    "GHSA-337j-9hxr-rhxg",
    "GHSA-jjmj-jmhj-qwj2"
  ]
}
